bin/
obj/
/packages/
riderModule.iml
/_ReSharper.Caches/
build
.idea
*.iml

# Session 10: crash dumps (~4.8GB, grows without bound) — never belong in the repo.
crashdumps/
*.dmp

# Per-character runtime config and logs — regenerated locally, not source.
# (tracer_*.txt/tracer_log.json live under C:\Users\Public, outside this repo
# entirely, so they don't need an entry here.)
*.ini
*.log

# Session 10: DPAPI-encrypted saved login credentials (launcher.exe's
# character-select screen). Already covered transitively by `build` above
# since it's written next to launcher.exe, but called out explicitly —
# never belongs in the repo regardless of where it ends up.
accounts.dat

# Session 10: one-shot crash-recovery-relaunch marker (see dllmain.cpp's
# ConsumeResumeHuntMarker()) — transient, written and deleted at runtime.
resume_hunt.flag

# Session 12: Python bytecode cache from running tools/*.py locally.
__pycache__/